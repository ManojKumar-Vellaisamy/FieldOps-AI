# ──────────────────────────────────────────────
# FieldOps AI – Root Environment Variables
# Copy this file to .env and fill in values.
# DO NOT commit .env to version control.
# ──────────────────────────────────────────────

# ── Frontend ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="FieldOps AI"
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# ── Backend ───────────────────────────────────
APP_ENV=development
APP_NAME="FieldOps AI API"
APP_VERSION=1.0.0
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# ── Database ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fieldops_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fieldops_ai

# ── API ───────────────────────────────────────
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── CORS ──────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
