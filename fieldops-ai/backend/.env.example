# ──────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in values.
# ──────────────────────────────────────────────

# ── Application ───────────────────────────────
APP_ENV=development
APP_NAME="FieldOps AI API"
APP_VERSION=1.0.0
APP_DEBUG=true

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security ──────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fieldops_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fieldops_ai
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fieldops_ai_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── CORS ──────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Logging ───────────────────────────────────
LOG_LEVEL=DEBUG

# ── Context Data Providers ──────────────────────────────────────────────────
# Traffic Provider: "tomtom" (REAL live traffic, requires key) | "osrm" (DERIVED routing baseline) | "none"
TRAFFIC_PROVIDER=osrm
TRAFFIC_TIMEOUT_SECONDS=4.0
# To activate REAL TomTom traffic, supply your API key below (or set TOMTOM_API_KEY) and set TRAFFIC_PROVIDER=tomtom:
# TRAFFIC_PROVIDER=tomtom
# TRAFFIC_API_KEY=your-tomtom-api-key-here
# TOMTOM_API_KEY=your-tomtom-api-key-here
# TRAFFIC_API_URL=https://api.tomtom.com

# Events feed (UNAVAILABLE when not configured — 0 min delay, no fake data)
# EVENTS_API_KEY=your-events-api-key
# EVENTS_API_URL=https://your-events-feed-url

# Road restrictions feed (uses existing TOMTOM_API_KEY or TRAFFIC_API_KEY if not specified)
# ROAD_RESTRICTION_API_KEY=your-tomtom-key-here
# ROAD_RESTRICTION_API_URL=https://api.tomtom.com/traffic/services/5/incidentDetails
# ROAD_RESTRICTION_TIMEOUT_SECONDS=4.0
